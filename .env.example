# .env       -> database Dev untuk `npm run dev` dan `npm run db:*`
# .env.local -> opsional, override untuk menjalankan aplikasi dengan Supabase lokal
# .env.prod  -> database Production, hanya untuk `npm run db:*:prod`
# Vercel Preview dan Production menggunakan Environment Variables project masing-masing.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Server dashboard. Isi key dari project yang sama dengan URL Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (supabase.com/dashboard/account/tokens) untuk scripts/db.mjs
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# Billing platform di dashboard. Isi Test untuk lokal/Preview dan Live untuk Vercel Production.
XENDIT_TEST_SECRET_KEY=
XENDIT_TEST_WEBHOOK_TOKEN=
XENDIT_TEST_BUSINESS_ID=
XENDIT_LIVE_SECRET_KEY=
XENDIT_LIVE_WEBHOOK_TOKEN=
XENDIT_LIVE_BUSINESS_ID=
# Origin HTTPS untuk halaman kembali dari Xendit. Isi dengan origin tunnel saat uji checkout lokal.
PLATFORM_BILLING_PUBLIC_URL=
# Opsional. URL deployment seberang untuk pilihan Test/Live di header platform.
PLATFORM_BILLING_TEST_DASHBOARD_URL=
PLATFORM_BILLING_LIVE_DASHBOARD_URL=
# Secret server yang juga disimpan di Vault bila rekonsiliasi berkala diaktifkan.
BILLING_CRON_SECRET=
# Opsional. Host tunnel yang dipakai dev server lokal, tanpa protokol dan path.
DEV_TUNNEL_HOST=
