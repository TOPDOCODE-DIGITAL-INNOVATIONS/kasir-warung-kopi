# =====================================================================
# Konfigurasi Terpusat Kasir Warung Kopi (admin-dashboard & app-kasir)
# Salin file ini menjadi .env di root repo: cp .env.example .env
# =====================================================================

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-or-publishable-key

# RAHASIA: hanya di server (Vercel env), jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# Opsional: Password database Supabase (untuk keperluan CLI / migrasi)
SUPABASE_DB_PASSWORD=your-db-password

