# Satu file .env untuk semua lingkungan. Nama variabel sama, hanya value yang beda.
# Lokal: salin ke .env. Vercel: isi nama yang sama di Settings → Environment Variables
# (Development / Preview / Production).

# Lingkungan: development | preview | production
APP_ENV=development

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=
# Untuk npm run db:*
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# --- Billing / Xendit ---
BILLING_ENABLED=false
# dev: xnd_development_..., prod: xnd_production_...
XENDIT_SECRET_KEY=xnd_development_xxxx
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=

# --- Situs & identitas (landing, /terms, /privacy) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Format internasional tanpa +, mis. 6281234567890
NEXT_PUBLIC_SUPPORT_WHATSAPP=
