#!/bin/sh
# Pre-commit: tolak commit yang berisi credential/token.
# Aktifkan sekali per clone: npm install  (atau: git config core.hooksPath .githooks)
# Darurat saja (jangan dibiasakan): git commit --no-verify

# 1. File env asli tidak boleh di-commit sama sekali.
blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "✖ Commit ditolak: file env berisi rahasia ikut di-stage:"
  echo "$blocked" | sed 's/^/    /'
  echo "  Jalankan: git restore --staged <file>"
  exit 1
fi

# 2. Scan isi perubahan dengan gitleaks.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠ gitleaks belum terpasang, scan rahasia dilewati."
  echo "  Pasang: brew install gitleaks  (lainnya: https://github.com/gitleaks/gitleaks#installing)"
  exit 0
fi

if ! gitleaks git --staged --redact -v --no-banner --log-level warn -c "$(git rev-parse --show-toplevel)/.gitleaks.toml"; then
  echo ""
  echo "✖ Commit ditolak: gitleaks menemukan credential/token di perubahan yang di-stage."
  echo "  Pindahkan nilainya ke .env (lokal) / Vercel Environment Variables, lalu commit ulang."
  echo "  Kalau ini false positive, tambahkan fingerprint-nya ke .gitleaksignore."
  exit 1
fi
