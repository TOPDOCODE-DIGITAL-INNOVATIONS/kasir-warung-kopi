# .env      -> database DEV (dipakai `npm run dev` admin-dashboard & app-kasir, dan `npm run db:*`)
# .env.prod -> database PROD (HANYA dipakai `npm run db:*:prod`; salin file ini lalu isi nilai prod)
# Production di Vercel TIDAK membaca file ini: set env di Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Personal access token (supabase.com/dashboard/account/tokens) untuk scripts/db.mjs
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# --- Server (rahasia) ---
SUPABASE_SERVICE_ROLE_KEY=
XENDIT_TEST_SECRET_KEY=xnd_development_xxxxxxxx
# XENDIT_LIVE_SECRET_KEY=xnd_production_xxxxxxxx
# Lingkungan billing yang dipakai Owner: test (default) | live
BILLING_ENVIRONMENT=test
# URL publik untuk tautan kembali dari Xendit (wajib https di production)
NEXT_PUBLIC_SITE_URL=https://kasir-warung-kopi.vercel.app

# --- Identitas untuk landing & halaman legal (/terms, /privacy) ---
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Format internasional tanpa +, mis. 6281234567890
NEXT_PUBLIC_SUPPORT_WHATSAPP=
